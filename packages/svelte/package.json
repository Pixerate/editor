{
  "name": "@pixerate/editor-svelte",
  "version": "0.75.0",
  "description": "Svelte bindings and prompt/rich-text components for @pixerate/editor",
  "author": "Pixerate",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Pixerate/editor.git",
    "directory": "packages/svelte"
  },
  "type": "module",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./spreadsheet": {
      "types": "./dist/spreadsheet/index.d.ts",
      "svelte": "./dist/spreadsheet/index.js",
      "default": "./dist/spreadsheet/index.js"
    },
    "./canvas": {
      "types": "./dist/canvas/index.d.ts",
      "svelte": "./dist/canvas/index.js",
      "default": "./dist/canvas/index.js"
    },
    "./image-editor": {
      "types": "./dist/image-editor/index.d.ts",
      "svelte": "./dist/image-editor/index.js",
      "default": "./dist/image-editor/index.js"
    },
    "./paint-editor": {
      "types": "./dist/paint-editor/index.d.ts",
      "svelte": "./dist/paint-editor/index.js",
      "default": "./dist/paint-editor/index.js"
    },
    "./commands": {
      "types": "./dist/commands/index.d.ts",
      "svelte": "./dist/commands/index.js",
      "default": "./dist/commands/index.js"
    },
    "./persistence": {
      "types": "./dist/persistence/index.d.ts",
      "svelte": "./dist/persistence/index.js",
      "default": "./dist/persistence/index.js"
    },
    "./generation": {
      "types": "./dist/generation/index.d.ts",
      "svelte": "./dist/generation/index.js",
      "default": "./dist/generation/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "svelte": "./dist/tokens/index.js",
      "default": "./dist/tokens/index.js"
    },
    "./parameters": {
      "types": "./dist/parameters/index.d.ts",
      "svelte": "./dist/parameters/index.js",
      "default": "./dist/parameters/index.js"
    },
    "./vector": {
      "types": "./dist/vector/index.d.ts",
      "svelte": "./dist/vector/index.js",
      "default": "./dist/vector/index.js"
    },
    "./animation-editor": {
      "types": "./dist/animation-editor/index.d.ts",
      "svelte": "./dist/animation-editor/index.js",
      "default": "./dist/animation-editor/index.js"
    },
    "./chart": {
      "types": "./dist/chart/index.d.ts",
      "svelte": "./dist/chart/index.js",
      "default": "./dist/chart/index.js"
    },
    "./video-editor": {
      "types": "./dist/video-editor/index.d.ts",
      "svelte": "./dist/video-editor/index.js",
      "default": "./dist/video-editor/index.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "spreadsheet": [
        "./dist/spreadsheet/index.d.ts"
      ],
      "canvas": [
        "./dist/canvas/index.d.ts"
      ],
      "image-editor": [
        "./dist/image-editor/index.d.ts"
      ],
      "paint-editor": [
        "./dist/paint-editor/index.d.ts"
      ],
      "commands": [
        "./dist/commands/index.d.ts"
      ],
      "persistence": [
        "./dist/persistence/index.d.ts"
      ],
      "generation": [
        "./dist/generation/index.d.ts"
      ],
      "tokens": [
        "./dist/tokens/index.d.ts"
      ],
      "parameters": [
        "./dist/parameters/index.d.ts"
      ],
      "vector": [
        "./dist/vector/index.d.ts"
      ],
      "animation-editor": [
        "./dist/animation-editor/index.d.ts"
      ],
      "chart": [
        "./dist/chart/index.d.ts"
      ],
      "video-editor": [
        "./dist/video-editor/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "svelte-package -i src -o dist",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings=false",
    "test": "vitest run"
  },
  "dependencies": {
    "@pixerate/editor": "workspace:*",
    "@tiptap/extension-bubble-menu": "^2.11.5",
    "@tiptap/extension-placeholder": "^2.11.5",
    "@tiptap/starter-kit": "^2.11.5"
  },
  "peerDependencies": {
    "@dagrejs/dagre": "^1.1.4",
    "@tiptap/core": "^2.11.5",
    "@tiptap/pm": "^2.11.5",
    "@xyflow/svelte": "^1.6.0",
    "svelte": "^5.57.2"
  },
  "peerDependenciesMeta": {
    "@dagrejs/dagre": {
      "optional": true
    },
    "@xyflow/svelte": {
      "optional": true
    }
  },
  "devDependencies": {
    "@dagrejs/dagre": "^1.1.4",
    "@sveltejs/package": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tiptap/core": "^2.11.5",
    "@tiptap/pm": "^2.11.5",
    "@types/dagre": "^0.7.52",
    "@xyflow/svelte": "^1.7.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "^5.7.3",
    "vitest": "^5.0.5"
  }
}
