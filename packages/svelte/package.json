{
  "name": "@pixerate/editor-svelte",
  "version": "0.17.0",
  "description": "Svelte bindings and prompt/rich-text components for @pixerate/editor",
  "author": "Pixerate",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Pixerate/editor.git",
    "directory": "packages/svelte"
  },
  "type": "module",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./canvas": {
      "types": "./dist/canvas/index.d.ts",
      "svelte": "./dist/canvas/index.js",
      "default": "./dist/canvas/index.js"
    },
    "./image-editor": {
      "types": "./dist/image-editor/index.d.ts",
      "svelte": "./dist/image-editor/index.js",
      "default": "./dist/image-editor/index.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "canvas": [
        "./dist/canvas/index.d.ts"
      ],
      "image-editor": [
        "./dist/image-editor/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "svelte-package -i src -o dist",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings=false",
    "test": "vitest run"
  },
  "dependencies": {
    "@dagrejs/dagre": "^1.1.4",
    "@pixerate/editor": "workspace:*",
    "@tiptap/extension-bubble-menu": "^2.11.5",
    "@tiptap/extension-placeholder": "^2.11.5",
    "@tiptap/starter-kit": "^2.11.5"
  },
  "peerDependencies": {
    "@tiptap/core": "^2.11.5",
    "@tiptap/pm": "^2.11.5",
    "@xyflow/svelte": "^1.6.0",
    "svelte": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@xyflow/svelte": {
      "optional": true
    }
  },
  "devDependencies": {
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tiptap/core": "^2.11.5",
    "@tiptap/pm": "^2.11.5",
    "@types/dagre": "^0.7.52",
    "@xyflow/svelte": "^1.6.6",
    "svelte": "^5.0.0",
    "svelte-check": "^4.7.6",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  }
}
