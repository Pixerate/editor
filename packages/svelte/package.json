{
  "name": "@pixerate/editor-svelte",
  "version": "0.3.12",
  "description": "Svelte bindings and prompt/rich-text components for @pixerate/editor",
  "author": "Pixerate",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Pixerate/editor.git",
    "directory": "packages/svelte"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "svelte": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./canvas": {
      "types": "./dist/canvas/index.d.ts",
      "svelte": "./dist/canvas/index.js",
      "import": "./dist/canvas/index.js",
      "default": "./dist/canvas/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "canvas": [
        "./dist/canvas/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@dagrejs/dagre": "^1.1.4",
    "@pixerate/editor": "workspace:*",
    "@tiptap/core": "^2.11.5",
    "@tiptap/extension-bubble-menu": "^2.11.5",
    "@tiptap/extension-placeholder": "^2.11.5",
    "@tiptap/pm": "^2.11.5",
    "@tiptap/starter-kit": "^2.11.5"
  },
  "peerDependencies": {
    "@xyflow/svelte": "^1.6.0",
    "svelte": "^4.0.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "@xyflow/svelte": {
      "optional": true
    }
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@types/dagre": "^0.7.52",
    "@xyflow/svelte": "^1.6.6",
    "esbuild-svelte": "^0.9.5",
    "svelte": "^5.0.0",
    "svelte-preprocess": "^6.0.5",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
