                "change": 0.2,
                "count": 2,
                "gaps": 0,
                "id": "s1",
                "max": 120,
                "maxAt": "Q2",
                "mean": 110,
                "min": 100,
                "minAt": "Q1",
                "name": "Revenue",
                "sum": 220,
                "trend": "rising"
