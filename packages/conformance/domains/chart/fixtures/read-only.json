    {
      "tool": "update_chart",
      "arguments": {
        "title": "Changed"
      },
      "expect": {
        "result": {
          "error": {
            "code": "unknown_tool",
            "message": "Unknown tool \"update_chart\". List the tools again; the editor that had it may have closed or become read-only."
          }
        },
        "isError": true
      }
    },
    {
      "tool": "set_chart_values",
      "arguments": {
        "cells": [
          {
            "series": "s1",
            "category": 0,
            "value": 5
          }
        ]
      },
      "expect": {
        "result": {
          "error": {
            "code": "unknown_tool",
            "message": "Unknown tool \"set_chart_values\". List the tools again; the editor that had it may have closed or become read-only."
          }
        },
        "isError": true
      }
    },
    {
      "tool": "load_file_chart",
      "arguments": {
        "file": "deck.pptx"
      },
      "expect": {
        "result": {
          "error": {
            "code": "unknown_tool",
            "message": "Unknown tool \"load_file_chart\". List the tools again; the editor that had it may have closed or become read-only."
          }
        },
        "isError": true
      }
    },
    {
      "tool": "list_open_files",
      "arguments": {},
      "expect": {
        "result": {
