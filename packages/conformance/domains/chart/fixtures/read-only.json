            "likertNeutral": "split",
            "likertSort": "none",
            "links": [],
            "map": "europe",
            "mapSteps": 5,
            "mapThresholds": [],
            "note": "",
            "orientation": "vertical",
            "overlap": -0.12,
            "palette": [
              "#4269d0",
              "#efb118",
              "#ff725c",
              "#6cc5b0",
              "#3ca951",
              "#ff8ab7",
