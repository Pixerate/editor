    "spec": {
      "type": "bar",
      "categories": [
        "Q1",
        "Q2"
      ],
      "series": [
        {
          "id": "s1",
          "name": "Revenue",
          "values": [
            100,
            120
          ]
        }
      ]
    }
  },
  "steps": [
    {
      "tool": "get_chart",
      "arguments": {},
