{
  "$schema": "../../../schema/fixture.schema.json",
  "id": "style-brand-invalid",
  "description": "A brand.json that fails its schema is left out with the reason (#791); the chart profile still applies.",
  "setup": {
    "width": 640,
    "height": 400,
    "spec": {
      "type": "bar",
      "categories": [
        "Q1"
      ],
      "series": [
        {
          "id": "s1",
          "name": "North",
          "values": [
            100
          ]
        }
      ]
    },
    "brand": {
      "colors": {
        "primary": 3
      },
      "palette": [],
      "mood": "calm",
