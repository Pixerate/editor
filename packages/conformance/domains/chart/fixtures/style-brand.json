              "severity": "error",
              "target": {
                "kind": "series",
                "seriesId": "s1"
              }
            },
            {
              "check": "palette-only",
              "layer": "org",
              "message": "Series \"South\" uses #efb118, which is not in the house palette; use #ff6a00 or another palette colour (#0b5fff, #ff6a00).",
              "severity": "error",
              "target": {
                "kind": "series",
                "seriesId": "s2"
              }
            },
            {
              "check": "min-contrast",
              "layer": "org",
              "message": "Series \"South\" (#efb118) has contrast 1.91:1 against the background #ffffff; want at least 3:1, so use a darker or lighter palette colour.",
              "severity": "warning",
              "target": {
                "kind": "series",
                "seriesId": "s2"
              }
            }
          ],
          "ok": false,
          "ran": [
            "distinguishable",
            "palette-only",
            "fonts-allowed",
            "min-contrast"
          ],
          "skipped": [
            {
              "check": "no-such-check",
              "reason": "There is no \"no-such-check\" check for chart; it has \"palette-only\", \"distinguishable\", \"min-contrast\", \"allowed-type\", \"fonts-allowed\"."
