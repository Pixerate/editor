        {
          "id": "s2",
          "name": "South",
          "values": [
            80,
            90
          ]
        }
      ]
    },
    "brand": {
      "name": "Acme",
      "colors": {
        "primary": "#0b5fff",
        "secondary": "#ff6a00",
        "text": "#1a1a1a",
        "background": "#ffffff",
        "border": "#d9d9d9"
      },
      "fonts": {
