{
  "$schema": "../../../schema/fixture.schema.json",
  "id": "style-brand",
  "description": "A brand.json beside the chart profile (#791): the chart's palette and theme come from the brand, the brand's checks run after the profile's own (a domain check with the same id wins), and an unknown check names every chart check, fonts-allowed included.",
  "setup": {
    "width": 640,
    "height": 400,
    "spec": {
      "type": "bar",
      "categories": [
        "Q1",
        "Q2"
      ],
      "series": [
        {
          "id": "s1",
          "name": "North",
          "values": [
