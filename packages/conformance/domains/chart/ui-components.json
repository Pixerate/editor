{
  "components": [
    {
      "id": "sparkline",
      "title": "Sparkline",
      "description": "A word-sized line chart of one run of values, without axes or labels.",
      "descriptor": {
        "implements": "sparkline",
        "group": "data-visual",
        "contract": {
          "props": {
            "type": "object",
            "properties": {
              "values": {
                "type": "array",
                "items": {
                  "type": "number",
                  "description": "A finite number."
                },
                "minItems": 1,
                "maxItems": 100000,
                "description": "The values in order, left to right."
              },
              "label": {
                "type": "string",
                "description": "Accessible name, e.g. \"Weekly sign-ups\" (default: a description of the values)."
              }
            },
            "required": [
              "values"
            ],
            "additionalProperties": false
          },
          "state": [],
          "events": [],
          "a11y": {
            "role": "img",
            "keyboard": {},
            "labelFrom": "content"
          },
          "colorRoles": [
            "accent"
          ],
          "motion": false,
          "sizing": {
            "mode": "intrinsic",
            "minWidth": 24,
            "minHeight": 8,
            "aspectRatio": 5
          }
        },
        "platforms": [
          "html-page",
          "swiftui"
        ],
        "swiftReady": true,
        "example": {
          "values": [
            12,
            15,
            14,
            18,
            22,
            21,
            26,
            24,
            29,
            33
          ],
          "label": "Weekly sign-ups"
        },
        "fallback": "table",
        "contentHash": "h1-ab15bc9b81e7a188"
      },
      "colorRoleUse": {
        "accent": "The line."
      },
      "defaultColors": {
        "light": {
          "accent": "#4269d0"
        },
        "dark": {
          "accent": "#97bbf5"
        }
      },
      "exampleSize": {
        "width": 120,
        "height": 24
      }
    },
    {
      "id": "bar-chart",
      "title": "Bar chart",
      "description": "Vertical bars comparing values across categories, one colour per series, with a value axis and a legend for several series.",
      "descriptor": {
        "implements": "bar-chart",
        "group": "data-visual",
        "contract": {
          "props": {
            "type": "object",
            "properties": {
              "categories": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1,
                "maxItems": 500,
                "description": "Category labels along the axis, in order."
              },
              "series": {
                "type": "array",
                "minItems": 1,
                "maxItems": 20,
                "description": "One bar per category for each series; several series are grouped side by side.",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "description": "Series name (legend)."
                    },
                    "values": {
                      "type": "array",
                      "items": {
                        "type": "number",
                        "description": "A finite number."
                      },
                      "description": "One value per category, in category order."
                    }
                  },
                  "required": [
                    "name",
                    "values"
                  ],
                  "additionalProperties": false
                }
              },
              "title": {
                "type": "string",
                "description": "Title drawn above the chart and used as its accessible name."
              },
              "unit": {
                "type": "string",
                "description": "Written after every tick and value, e.g. \"%\" or \" kWh\"."
              }
            },
            "required": [
              "categories",
              "series"
            ],
            "additionalProperties": false
          },
          "state": [],
          "events": [],
          "a11y": {
            "role": "img",
            "keyboard": {},
            "labelFrom": "content"
          },
          "colorRoles": [
            "surface",
            "ink",
            "ink-muted",
            "border",
            "accent"
          ],
          "motion": false,
          "sizing": {
            "mode": "fill",
            "minWidth": 160,
            "minHeight": 120
          }
        },
        "platforms": [
          "html-page",
          "swiftui"
        ],
        "swiftReady": true,
        "example": {
          "title": "Quarterly revenue",
          "unit": "k",
          "categories": [
