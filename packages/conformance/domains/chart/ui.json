{
  "layoutPresets": [
    {
      "id": "standard",
      "label": "Standard",
      "description": "Legend at the bottom, value grid lines, no data labels.",
      "patch": {
        "legend": {
          "show": true,
          "position": "bottom"
        },
        "dataLabels": false,
        "xAxis": {
          "gridlines": false,
          "show": true
        },
        "yAxis": {
          "gridlines": true,
          "show": true
        }
      }
    },
    {
      "id": "minimal",
      "label": "Minimal",
      "description": "No legend, grid lines or axis titles; the data speaks.",
      "patch": {
        "legend": {
          "show": false
        },
        "dataLabels": false,
        "xAxis": {
          "gridlines": false,
          "title": ""
        },
        "yAxis": {
          "gridlines": false,
          "title": ""
        }
      }
    },
    {
      "id": "labelled",
      "label": "Labelled",
      "description": "Values written on the marks, no value axis or grid lines.",
      "patch": {
        "dataLabels": true,
        "labelPosition": "auto",
        "yAxis": {
          "show": false,
          "gridlines": false
        },
        "xAxis": {
          "gridlines": false
        }
      }
    },
    {
      "id": "legend-right",
      "label": "Legend on the right",
      "description": "Legend beside the plot, value grid lines.",
      "patch": {
        "legend": {
          "show": true,
          "position": "right"
        },
        "yAxis": {
          "gridlines": true
        }
      }
    },
    {
      "id": "presentation",
      "label": "Presentation",
      "description": "Legend on top, data labels, light grid.",
      "patch": {
        "legend": {
          "show": true,
          "position": "top"
        },
        "dataLabels": true,
        "yAxis": {
          "gridlines": true
        },
        "xAxis": {
          "gridlines": false
        }
      }
    },
    {
      "id": "analysis",
      "label": "Analysis",
      "description": "Grid lines on both axes, point markers, legend at the bottom.",
      "patch": {
        "legend": {
          "show": true,
          "position": "bottom"
        },
        "points": true,
        "dataLabels": false,
        "xAxis": {
          "gridlines": true
        },
        "yAxis": {
          "gridlines": true
        }
      }
    }
  ],
