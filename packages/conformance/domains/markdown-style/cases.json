    "name": "issue example: a banned term, a title-case heading and a slash date",
    "source": "# Our New Release Plan\n\nWe utilize the tool from 3/4/2026 onwards.\n",
    "profile": {
      "headingCase": "sentence",
      "terms": [
        {
          "avoid": "utilize",
          "use": "use"
        }
      ],
      "dateFormat": "day-month-year",
      "checks": [
        "heading-case",
        "terms",
        "date-format"
      ]
    },
    "expected": {
      "blocks": [
        {
          "kind": "heading",
          "level": 1,
          "text": "Our New Release Plan",
          "from": 2,
          "to": 22
        },
        {
          "kind": "paragraph",
          "text": "We utilize the tool from 3/4/2026 onwards.",
          "from": 24,
          "to": 66
        }
      ],
      "findings": [
        {
          "check": "heading-case",
          "severity": "warning",
          "message": "Heading \"Our New Release Plan\" is not in sentence case; write \"Our new release plan\".",
          "from": 6,
          "to": 22,
          "replacement": "new release plan"
        },
        {
          "check": "terms",
          "severity": "warning",
          "message": "Avoid \"utilize\"; write \"use\".",
          "from": 27,
          "to": 34,
          "replacement": "use"
        },
        {
          "check": "date-format",
          "severity": "warning",
          "message": "3/4/2026 can be read as two different dates; write it as 12 November YYYY-style.",
          "from": 49,
          "to": 57
        }
      ],
      "fixed": "# Our new release plan\n\nWe use the tool from 3/4/2026 onwards.\n"
    }
  },
