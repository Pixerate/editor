      ],
      "findings": [
        {
          "check": "heading-case",
          "severity": "warning",
          "message": "Heading \"Our New Release Plan\" is not in sentence case; write \"Our new release plan\".",
          "from": 6,
          "to": 22,
          "replacement": "new release plan"
