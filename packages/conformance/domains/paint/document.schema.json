{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "document.schema.json",
  "type": "object",
  "description": "A saved painting, as the paint editor's save tools and autosave write it.",
  "properties": {
    "format": {
      "type": "string",
      "const": "pixerate.editor-document",
      "description": "Always \"pixerate.editor-document\"."
    },
    "kind": {
      "type": "string",
      "const": "paint",
      "description": "Always \"paint\"."
    },
    "formatVersion": {
      "type": "integer",
      "minimum": 1,
      "description": "Version of the envelope for this kind; readers migrate older ones."
    },
    "name": {
      "type": "string",
      "description": "Display name, when it has one."
    },
    "document": {
      "type": "object",
      "description": "The painting (`SerializedPaintDocument`).",
      "properties": {
        "format": {
          "type": "string",
          "const": "pixerate-paint",
          "description": "Always \"pixerate-paint\"."
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2,
          "description": "Painting version (2; version 1 strokes hold flat engine brushes and are migrated)."
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "description": "Canvas width in pixels."
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "description": "Canvas height in pixels."
        },
        "dpi": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Pixels per inch."
        },
        "paper": {
          "type": "object",
          "description": "The paper settings; the paper is regenerated from them, never stored as pixels.",
          "properties": {
            "preset": {
              "type": "string",
              "description": "The paper preset it started from (custom when none)."
            },
            "name": {
              "type": "string",
              "description": "Display name."
            },
            "pattern": {
              "type": "string",
              "description": "Grain pattern id."
            },
            "seed": {
              "type": "number",
              "description": "Grain seed."
            },
            "color": {
              "type": "string",
              "description": "Paper colour #rrggbb."
            },
            "scale": {
              "type": "number",
              "description": "Grain scale (0.25 to 8)."
            },
            "depth": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Grain depth for dry media."
            }
          },
          "required": [
            "preset",
            "pattern",
            "seed",
            "color"
          ]
        },
        "layers": {
          "type": "array",
          "description": "Bottom to top: the image editor's serialized layers (pixel layers keep their pixels in `assets`).",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "Layer id."
              },
              "name": {
                "type": "string",
                "description": "Layer name."
              },
              "type": {
                "type": "string",
                "description": "pixel, group, …"
              }
            },
            "required": [
              "id",
              "type"
            ]
          }
        },
        "assets": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Asset id → PNG data URL or an external reference."
        },
        "activeLayerId": {
          "type": [
            "string",
            "null"
          ],
          "description": "The active layer."
        },
        "strokes": {
          "type": "array",
          "description": "Recorded strokes, oldest first (missing when saved without them).",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "Stroke id."
              },
              "layerId": {
                "type": "string",
                "description": "The layer it painted on."
              },
              "color": {
                "type": "string",
                "description": "The paint colour as recorded at stroke start."
              },
              "seed": {
                "type": "number",
                "description": "Seed of its jitter and grain, so a replay is exact."
              },
              "points": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "number",
                      "description": "Document x in pixels."
                    },
                    "y": {
                      "type": "number",
                      "description": "Document y in pixels."
                    }
                  },
                  "required": [
                    "x",
                    "y"
                  ]
                },
                "description": "The samples, with pressure, tilt and time when recorded."
              },
              "brush": {
                "$ref": "../brushes/brush.schema.json",
                "description": "The facet brush it painted with."
              }
            },
            "required": [
              "id",
              "layerId",
              "points",
              "brush"
            ]
          }
        },
        "ferro": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Layer id → asset id of its liquid ferrofluid map."
        },
        "ferroSettings": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "wavelength": {
                "type": "number",
                "description": "Rosensweig spike spacing in pixels."
              },
              "threshold": {
                "type": "number",
                "description": "Critical magnetic field threshold."
              }
            }
          },
          "description": "Layer id → ferrofluid spike settings."
        },
        "magnets": {
          "type": "array",
          "description": "Magnets on the canvas that pull liquid ferrofluid into spikes.",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "Magnet id."
              },
              "x": {
                "type": "number",
                "description": "Document x in pixels."
              },
              "y": {
                "type": "number",
                "description": "Document y in pixels."
              },
              "strength": {
                "type": "number",
                "minimum": -1,
                "maximum": 1,
                "description": "Magnet dipole strength (-1..1)."
              },
              "radius": {
                "type": "number",
                "minimum": 4,
                "maximum": 512,
                "description": "Magnet field falloff radius in pixels."
              }
            },
            "required": [
              "id",
              "x",
              "y",
              "strength",
              "radius"
            ]
          }
        },
        "fluor": {
          "type": "object",
          "description": "Per-layer UV-fluorescent ink channels (layerId → bounds + PNG data URL).",
          "additionalProperties": {
            "type": "object"
          }
        },
        "thermo": {
          "type": "object",
          "description": "Per-layer thermochromic ink channels (layerId → bounds + PNG data URL).",
          "additionalProperties": {
            "type": "object"
          }
        },
        "heat": {
          "type": "object",
          "description": "Coarse document heat field (width, height, png) when the canvas is warm.",
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 1,
              "description": "Heat grid width in cells (1/4 canvas resolution)."
            },
            "height": {
              "type": "integer",
              "minimum": 1,
              "description": "Heat grid height in cells (1/4 canvas resolution)."
            },
            "png": {
              "type": "string",
              "description": "Heat grid encoded as an RGBA PNG data URL."
            }
          },
          "required": [
            "width",
            "height",
            "png"
          ]
        },
        "uvLight": {
          "type": "object",
          "description": "Virtual UV blacklight settings when non-default.",
          "properties": {
            "on": {
              "type": "boolean",
              "description": "Whether the UV blacklight is switched on."
            },
            "strength": {
              "type": "number",
              "minimum": 0,
              "maximum": 2,
              "description": "UV emission and spill strength (0..2)."
            },
            "ambient": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Remaining daylight ambient level (0..1)."
            }
          }
        },
        "age": {
          "type": "object",
          "description": "Painting time-machine ageing preview settings when non-default.",
          "properties": {
            "years": {
              "type": "number",
              "minimum": 0,
              "maximum": 500,
              "description": "Simulated age in years (0..500; 0 = fresh paint)."
            },
            "varnish": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Yellowed varnish absorption strength (0..1)."
            },
            "cracks": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Voronoi / stress craquelure crack network strength (0..1)."
            },
            "fading": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Pigment lightfastness fading strength by hue (0..1)."
            },
            "dust": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Low-frequency surface dust grain strength (0..1)."
            },
            "seed": {
              "type": "integer",
              "minimum": 0,
              "description": "Deterministic seed for craquelure and dust."
            }
          }
        },
        "cultures": {
          "type": "object",
          "description": "Living and extinct biopaint (`culture`) colonies per layer, plus offline growth options.",
          "properties": {
            "layers": {
              "type": "object",
              "description": "Layer id → serialized `LayerCultureJSON` (tick, nextId, tips, segmentsTotal, status, occupancy).",
              "additionalProperties": {
                "type": "object"
              }
            },
            "growWhileClosed": {
              "type": "boolean",
              "description": "Whether living colonies catch up elapsed growth when reopened."
            },
            "lastGrownAt": {
              "type": "number",
              "description": "Timestamp in milliseconds when the document was saved with living colonies."
            }
          }
        }
      },
      "required": [
        "format",
        "version",
        "width",
        "height",
        "dpi",
        "paper",
        "layers",
        "assets",
        "activeLayerId"
      ]
    }
  },
  "required": [
    "format",
    "kind",
    "formatVersion",
    "document"
  ]
}
