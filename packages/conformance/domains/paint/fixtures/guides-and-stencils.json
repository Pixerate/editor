      "expect": {
        "result": {
          "error": {
            "code": "invalid_arguments",
            "details": [
              {
                "message": "Expected one of \"off\", \"vertical\", \"horizontal\", \"dual\", \"diagonal\", \"kaleidoscope\", got \"radial\".",
                "path": "/mode"
              }
            ],
            "message": "Invalid arguments for tool \"paint-editor__set_symmetry\"."
          }
        },
        "isError": true
      }
