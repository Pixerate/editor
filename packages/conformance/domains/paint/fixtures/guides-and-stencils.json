          "enabled": false,
          "feather": 1,
          "id": "stencil1",
          "invert": false,
          "kind": "shape",
          "mode": "mask",
          "rect": {
            "height": 20,
            "width": 32,
            "x": 8,
            "y": 6
          },
          "shape": "ellipse",
          "snap": 40
