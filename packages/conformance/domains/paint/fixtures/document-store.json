{
  "$schema": "../../../schema/fixture.schema.json",
  "id": "document-store",
  "description": "With the host's document store: save_paint_document saves the painting and its image assets under a name (the same name replaces that copy, no name saves \"Untitled paint\"), list_saved_paint_documents lists them newest first, open_saved_paint_document opens one by key and refuses unknown keys naming the saved ones, and find_unreferenced_paint_assets / delete_unreferenced_paint_assets find and delete the stored images no saved document or the open painting refers to (refusing references that are not unreferenced, deleting nothing); an image deleted while the editor still holds it is written again by the next save.",
  "setup": {
    "width": 48,
    "height": 32
  },
  "steps": [
    {
      "tool": "list_saved_paint_documents",
      "arguments": {},
      "expect": {
        "result": {
          "documents": []
        }
      }
    },
    {
      "tool": "open_saved_paint_document",
      "arguments": {
        "key": "paint/first-sketch"
      },
      "expect": {
        "result": {
          "error": {
            "code": "tool_failed",
            "message": "There is no saved document \"paint/first-sketch\". No paint documents are saved yet."
          }
        },
        "isError": true
      }
    },
    {
      "tool": "paint_stroke",
      "arguments": {
        "points": [
          {
            "x": 4,
            "y": 6,
            "pressure": 0.3
          },
          {
            "x": 20,
            "y": 12,
            "pressure": 0.8
          },
          {
            "x": 42,
            "y": 26,
            "pressure": 0.5
          }
        ],
        "seed": 3,
        "color": "#0a6040"
      },
      "expect": {
        "result": {
          "bounds": {
            "height": 31,
            "width": 49,
            "x": -1,
            "y": 1
          },
          "dabs": 87,
          "layerId": "@1",
          "strokeId": "s1"
        }
      }
    },
    {
      "tool": "save_paint_document",
      "arguments": {
        "name": "  First sketch!  "
      },
      "expect": {
        "result": {
          "key": "paint/first-sketch",
          "name": "First sketch!",
          "revision": 1,
          "savedAt": "<time>"
        }
      }
    },
    {
      "tool": "find_unreferenced_paint_assets",
      "arguments": {},
      "expect": {
        "result": {
          "assets": 1,
          "kept": 0,
          "more": 0,
          "referenced": 1,
          "refs": [],
          "unreferenced": 0,
          "unreferencedChars": 0
        }
      }
    },
    {
      "tool": "paint_stroke",
      "arguments": {
        "points": [
          {
            "x": 40,
            "y": 4,
            "pressure": 0.6
          },
          {
            "x": 8,
            "y": 28,
            "pressure": 0.4
          }
        ],
        "seed": 5,
        "color": "#a03020"
      },
      "expect": {
        "result": {
          "bounds": {
            "height": 36,
            "width": 44,
            "x": 2,
            "y": -2
          },
          "dabs": 81,
          "layerId": "@1",
          "strokeId": "s2"
        }
      }
    },
    {
      "tool": "save_paint_document",
      "arguments": {
        "name": "Second"
      },
      "expect": {
        "result": {
          "key": "paint/second",
          "name": "Second",
          "revision": 2,
          "savedAt": "<time>"
        }
      }
    },
    {
      "tool": "save_paint_document",
      "arguments": {},
      "expect": {
        "result": {
          "key": "paint/untitled-paint",
          "name": "Untitled paint",
          "revision": 2,
          "savedAt": "<time>"
        }
      }
    },
    {
      "tool": "list_saved_paint_documents",
      "arguments": {},
      "expect": {
        "result": {
          "documents": [
            {
              "formatVersion": 1,
              "key": "paint/untitled-paint",
              "name": "Untitled paint",
              "savedAt": "<time>"
            },
            {
              "formatVersion": 1,
              "key": "paint/second",
              "name": "Second",
              "savedAt": "<time>"
            },
            {
              "formatVersion": 1,
              "key": "paint/first-sketch",
              "name": "First sketch!",
              "savedAt": "<time>"
            }
          ]
        }
      }
    },
    {
      "tool": "save_paint_document",
      "arguments": {
        "name": "First sketch"
      },
      "expect": {
        "result": {
          "key": "paint/first-sketch",
          "name": "First sketch",
          "revision": 2,
          "savedAt": "<time>"
        }
      }
    },
    {
      "tool": "find_unreferenced_paint_assets",
      "arguments": {},
      "expect": {
        "result": {
          "assets": 2,
          "kept": 0,
          "more": 0,
          "referenced": 1,
          "refs": [
            "pixerate-asset:xi-a3g39dw5nz"
          ],
          "unreferenced": 1,
          "unreferencedChars": 1206
        }
      }
    },
    {
      "tool": "delete_unreferenced_paint_assets",
      "arguments": {
        "refs": [
          "pixerate-asset:zz-zz"
        ]
      },
      "expect": {
        "result": {
          "error": {
            "code": "tool_failed",
            "message": "1 of the given asset is not unreferenced in storage now (pixerate-asset:zz-zz): unknown, already deleted, referenced or in use. Nothing was deleted; find the unreferenced assets again."
          }
        },
        "isError": true
      }
    },
    {
      "tool": "delete_unreferenced_paint_assets",
      "arguments": {
        "refs": [
          "not-a-ref"
        ]
      },
      "expect": {
        "result": {
          "error": {
            "code": "invalid_arguments",
            "details": [
              {
                "message": "Must match pattern ^pixerate-asset:.",
                "path": "/refs/0"
              }
            ],
            "message": "Invalid arguments for tool \"delete_unreferenced_paint_assets\"."
          }
        },
        "isError": true
      }
    },
    {
      "tool": "open_saved_paint_document",
      "arguments": {
        "key": "paint/missing"
      },
      "expect": {
        "result": {
          "error": {
            "code": "tool_failed",
            "message": "There is no saved document \"paint/missing\". Saved paint documents: paint/first-sketch, paint/untitled-paint, paint/second."
