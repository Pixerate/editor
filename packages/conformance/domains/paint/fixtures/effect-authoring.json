{
  "$schema": "../../../schema/fixture.schema.json",
  "id": "effect-authoring",
  "description": "Writing an effect at run time in pixel expressions: opening a template, source with compile errors and a fix, values, presets, keyframes, timing, undo, saving it into the painting, and a provider effect that has no source.",
  "setup": {
    "width": 48,
    "height": 32,
    "authoredEffects": "author"
  },
  "steps": [
    {
      "tool": "list_authored_effects",
      "expect": {
        "result": {
          "effects": [],
          "open": null,
          "policy": "author"
        }
      }
    },
    {
      "tool": "effect_authoring_describe",
      "expect": {
        "result": {
          "error": {
            "code": "tool_failed",
            "message": "No effect is open for authoring; open one with open_effect_authoring (start from pixel.blank to write a new effect), then use the effect_authoring_* tools."
          }
        },
        "isError": true
      }
    },
    {
      "tool": "open_effect_authoring",
      "arguments": {
        "effect": "pixel.nope"
      },
      "expect": {
        "result": {
          "error": {
            "code": "tool_failed",
            "message": "There is no template \"pixel.nope\"; the templates are pixel.blank, pixel.rings, pixel.clouds."
          }
        },
        "isError": true
      }
    },
    {
      "tool": "open_effect_authoring",
      "arguments": {
        "effect": "pixel.blank"
      },
      "expect": {
        "result": {
          "compiled": true,
          "controls": [
            {
              "alpha": false,
              "default": "#1d2b53",
              "description": "Colour at the top. (#rrggbb)",
              "id": "top",
              "type": "color"
            },
            {
              "alpha": false,
              "default": "#ff77a8",
              "description": "Colour at the bottom. (#rrggbb)",
              "id": "bottom",
              "type": "color"
            }
          ],
          "duration": 1000,
          "from": "pixel.blank",
          "issues": [],
          "loop": false,
          "name": "Blank",
          "source": "control top: color = #1d2b53 // Colour at the top.\ncontrol bottom: color = #ff77a8 // Colour at the bottom.\nout = mix(top, bottom, uv.y)\n",
          "sourceLanguage": "pixel",
          "values": {
            "bottom": "#ff77a8",
            "top": "#1d2b53"
          }
        }
      }
    },
    {
      "tool": "effect_authoring_get_source",
      "expect": {
        "result": {
          "language": "pixel",
          "source": "control top: color = #1d2b53 // Colour at the top.\ncontrol bottom: color = #ff77a8 // Colour at the bottom.\nout = mix(top, bottom, uv.y)\n"
        }
      }
    },
    {
      "tool": "effect_authoring_set_source",
      "arguments": {
        "source": "control glow: number = 0.5 range 0 1 // Glow.\nout = vec4(vec3(gloww), 1)"
      },
      "expect": {
        "result": {
          "issues": [
            {
              "line": 2,
              "message": "there is no \"gloww\"; defined so far: glow; built in: uv, pos, size, time, PI, TAU",
              "severity": "error"
            }
          ]
        }
      }
    },
    {
      "tool": "save_authored_effect",
      "expect": {
        "result": {
          "error": {
            "code": "tool_failed",
            "message": "The effect doesn't compile, so it can't be saved: line 2: there is no \"gloww\"; defined so far: glow; built in: uv, pos, size, time, PI, TAU. Fix the source (effect_authoring_set_source) and save again."
          }
        },
        "isError": true
      }
    },
    {
      "tool": "effect_authoring_set_source",
      "arguments": {
        "source": "// Rings over drifting noise.\ncontrol ink: color = #1d2b53 // Colour of the rings.\ncontrol glow: number = 0.5 range 0 1 // How bright the noise is.\ncontrol count: number = 6 range 1 32 // Rings across the picture.\ncontrol center: vec2 = vec2(0.5, 0.5) range 0 1 // Where the rings spread from.\ncontrol soft: bool = true // Soft edges.\nlet d = distance(uv, center)\nlet wave = 0.5 + 0.5 * sin((d * count - time) * TAU)\nlet edge = select(soft, smoothstep(0.3, 0.7, wave), step(0.5, wave))\nlet n = noise(pos / 6 + vec2(time, 0)) * glow\nlet base = mix(vec3(n), ink.rgb, edge)\nout = vec4(clamp(base + hash(floor(pos / 4)) * 0.05, 0, 1), max(edge, 0.25))\n"
      },
      "expect": {
        "result": {
          "issues": []
        }
      }
    },
    {
      "tool": "effect_authoring_set_values",
      "arguments": {
        "values": {
          "glow": 0.8,
          "count": 8
        }
      },
      "expect": {
        "result": {
          "values": {
            "center": [
              0.5,
              0.5
            ],
            "count": 8,
            "glow": 0.8,
            "ink": "#1d2b53",
            "soft": true
          }
        }
      }
    },
    {
      "tool": "effect_authoring_set_values",
      "arguments": {
        "values": {
          "glo": 0.8
        }
      },
      "expect": {
        "result": {
          "error": {
            "code": "tool_failed",
            "message": "there is no control \"glo\"; the controls are ink, glow, count, center, soft"
          }
        },
        "isError": true
      }
    },
    {
      "tool": "effect_authoring_set_values",
      "arguments": {
        "values": {
          "count": 99
        }
      },
      "expect": {
        "result": {
          "error": {
            "code": "tool_failed",
            "message": "control \"count\": Must be <= 32."
          }
        },
        "isError": true
      }
    },
    {
      "tool": "effect_authoring_save_preset",
      "arguments": {
        "name": "Bright"
      },
      "expect": {
        "result": {
          "name": "Bright",
          "values": {
            "center": [
              0.5,
              0.5
            ],
            "count": 8,
            "glow": 0.8,
            "ink": "#1d2b53",
            "soft": true
          }
        }
      }
    },
    {
      "tool": "effect_authoring_reset_values",
      "arguments": {
        "names": [
          "glow"
        ]
      },
      "expect": {
        "result": {
          "values": {
            "center": [
              0.5,
              0.5
            ],
            "count": 8,
            "glow": 0.5,
            "ink": "#1d2b53",
            "soft": true
          }
        }
      }
    },
    {
      "tool": "effect_authoring_apply_preset",
