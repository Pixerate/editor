{
  "$schema": "../../../schema/fixture.schema.json",
  "id": "effects",
  "description": "Effects from an effect provider: searching, effect layers, effects on layers and paper, and effect paint.",
  "setup": {
    "width": 48,
    "height": 32
  },
  "skip": {
    "swift": "The Swift paint editor is not ported yet (#540)."
  },
  "steps": [
    {
      "tool": "search_effects",
      "arguments": {
        "query": "tint"
      },
      "expect": {
        "result": {
          "available": true,
          "effects": [
            {
              "category": "image",
              "description": "Mixes the source towards a colour.",
              "id": "fake.tint",
              "kind": "shader",
              "loop": false,
              "name": "Tint",
              "tags": [
                "colour",
                "wash"
              ],
              "transparent": false,
              "uses": [
                "filter"
              ]
            }
          ],
          "provider": {
            "capabilities": {
              "maxSize": 8192,
              "supportsAuthoring": true,
              "supportsFloat": true,
              "supportsHostImages": false,
              "supportsMask": true,
              "supportsVector": true,
              "supportsWorker": false
            },
            "id": "fake",
            "name": "Fake effects"
          },
          "tags": [
            {
              "count": 1,
              "tag": "colour"
            },
            {
              "count": 1,
              "tag": "wash"
            }
          ],
          "total": 1
        }
      }
    },
    {
      "tool": "search_effects",
      "arguments": {
        "use": "generator"
      },
      "expect": {
        "result": {
          "available": true,
          "effects": [
            {
              "category": "gradient",
              "description": "A linear gradient between two colours that can turn over time.",
              "duration": 4000,
              "id": "fake.gradient",
              "kind": "shader",
              "loop": true,
              "name": "Gradient",
              "tags": [
                "background"
              ],
              "transparent": false,
              "uses": [
                "generator"
              ]
            }
          ],
          "provider": {
            "capabilities": {
              "maxSize": 8192,
              "supportsAuthoring": true,
              "supportsFloat": true,
              "supportsHostImages": false,
              "supportsMask": true,
              "supportsVector": true,
              "supportsWorker": false
            },
            "id": "fake",
            "name": "Fake effects"
          },
          "tags": [
            {
              "count": 1,
              "tag": "background"
            }
          ],
          "total": 1
        }
      }
    },
    {
      "tool": "describe_effect",
      "arguments": {
        "effect": "fake.tint"
      },
      "expect": {
        "result": {
          "appliesHere": true,
          "available": true,
          "category": "image",
          "controls": {
            "additionalProperties": false,
            "properties": {
              "amount": {
                "description": "How far to mix towards the colour, 0–1. Default 0.5.",
                "maximum": 1,
                "minimum": 0,
                "type": "number"
              },
              "color": {
                "description": "Tint colour as #rrggbb. Default #ff8800.",
                "pattern": "^#[0-9a-fA-F]{6}$",
                "type": "string"
              }
            },
            "type": "object"
          },
          "defaults": {
            "amount": 0.5,
            "color": "#ff8800"
          },
          "description": "Mixes the source towards a colour.",
          "id": "fake.tint",
          "inputs": [
            {
              "description": "The picture to tint.",
              "kind": "image",
              "name": "source",
              "required": true
            }
          ],
          "kind": "shader",
          "loop": false,
          "name": "Tint",
          "presets": [
            {
              "name": "Sepia",
              "values": {
                "amount": 0.4,
                "color": "#704214"
              }
            },
            {
              "name": "Cool",
              "values": {
                "amount": 0.25,
                "color": "#2060ff"
              }
            }
          ],
          "tags": [
            "colour",
            "wash"
          ],
          "transparent": false,
          "uses": [
            "filter"
          ]
        }
      }
    },
    {
      "tool": "fill_layer",
      "arguments": {
        "color": "#336699"
      },
      "expect": {
        "result": {
          "bounds": {
            "height": 32,
            "width": 48,
            "x": 0,
            "y": 0
          },
          "layerId": "@1"
        }
      }
    },
    {
      "tool": "add_effect_layer",
      "arguments": {
        "effect": "fake.gradient",
        "name": "Gradient",
        "opacity": 0.5
      },
      "pixels": true,
      "expect": {
        "result": {
          "effects": [
            {
              "effect": "fake.gradient",
              "enabled": true,
              "id": "effect",
              "name": "Gradient",
              "provider": "fake",
              "role": "effect layer",
              "values": {
                "angle": 90,
                "from": "#1e3a8a",
                "opacity": 1,
                "spin": 0,
                "to": "#f472b6"
              }
            }
          ],
          "layer": {
