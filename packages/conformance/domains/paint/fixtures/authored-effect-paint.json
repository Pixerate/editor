{
  "$schema": "../../../schema/fixture.schema.json",
  "id": "authored-effect-paint",
  "description": "An effect written at run time used as paint: saved into the painting, painted with fixed to the canvas and along a stroke, as an effect layer and as paper, kept with its source in the document, and painted with again after a reload with no authoring session.",
  "setup": {
    "width": 48,
    "height": 32,
    "authoredEffects": "author"
  },
  "steps": [
    {
      "tool": "open_effect_authoring",
      "arguments": {
        "effect": "pixel.blank"
      },
      "expect": {
        "result": {
          "compiled": true,
          "controls": [
            {
              "alpha": false,
              "default": "#1d2b53",
              "description": "Colour at the top. (#rrggbb)",
              "id": "top",
              "type": "color"
            },
            {
              "alpha": false,
              "default": "#ff77a8",
              "description": "Colour at the bottom. (#rrggbb)",
              "id": "bottom",
              "type": "color"
            }
          ],
          "duration": 1000,
          "from": "pixel.blank",
          "issues": [],
          "loop": false,
          "name": "Blank",
          "source": "control top: color = #1d2b53 // Colour at the top.\ncontrol bottom: color = #ff77a8 // Colour at the bottom.\nout = mix(top, bottom, uv.y)\n",
          "sourceLanguage": "pixel",
          "values": {
            "bottom": "#ff77a8",
            "top": "#1d2b53"
          }
        }
      }
    },
    {
      "tool": "effect_authoring_set_source",
      "arguments": {
        "source": "control leaf: color = #2f6b3a // Colour of the moss.\ncontrol light: color = #c9e27a // Colour of its tips.\ncontrol scale: number = 5 range 1 16 // Cells across the picture.\nlet n = noise(uv * scale) * 0.7 + noise(uv * scale * 3) * 0.3\nout = vec4(mix(leaf, light, smoothstep(0.35, 0.8, n)), smoothstep(0.2, 0.4, n))\n"
      },
      "expect": {
        "result": {
          "issues": []
        }
      }
    },
    {
      "tool": "save_authored_effect",
      "arguments": {
        "name": "Moss"
      },
      "expect": {
        "result": {
          "animated": [],
