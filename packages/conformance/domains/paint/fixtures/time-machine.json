        "result": {
          "error": {
            "code": "tool_failed",
            "message": "Unknown brush \"impasto-oil\". Closest: impasto-brush, oil-pastel, oil-round. Call list_brush_presets for the ids."
          }
        },
        "isError": true
      }
    },
    {
      "tool": "add_layer",
