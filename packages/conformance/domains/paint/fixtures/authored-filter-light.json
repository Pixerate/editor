              ],
              "duration": 1000,
              "id": "authored.glaze",
              "language": "pixel",
              "loop": false,
              "name": "Glaze",
              "uses": {
                "layers": [],
                "paint": false,
                "paper": false,
                "strokes": 0
              }
            }
          ],
          "open": null,
          "policy": "author"
        },
        "loaded": [],
        "pixels": {
          "file": "png/authored-filter-light.15.png",
