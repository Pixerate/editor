{
  "$schema": "../../../schema/fixture.schema.json",
  "id": "brush-and-colour",
  "description": "Choosing brushes, colours and gradient paint, then painting and picking colours.",
  "setup": {
    "width": 48,
    "height": 32
  },
  "steps": [
    {
      "tool": "get_brush",
      "expect": {
        "result": {
          "brush": {
            "behaviour": {
              "grain": 0.7
            },
            "dynamics": {
              "minSize": 0.5,
              "pressureOpacity": true,
              "pressureSmoothing": 0.3,
              "smoothing": 0.2,
              "tiltOpacity": 0.35,
              "tiltRoundness": 0.75,
              "tiltSize": 1
            },
            "id": "pencil-6b",
            "kind": "mark",
            "medium": "dry",
            "name": "6B pencil",
            "tip": {
              "flow": 0.75,
              "hardness": 0.55,
              "shape": "round",
              "size": 7,
              "spacing": 0.07
            },
            "variety": "pencil"
          },
          "builtin": true,
          "category": "pencil",
          "engine": "dab",
          "strokePaint": {
            "color": "#1f2937",
            "type": "color"
          }
        }
      }
    },
    {
      "tool": "set_color",
      "arguments": {
        "color": "#b03030",
        "secondaryColor": "#2050a0"
      },
      "expect": {
        "result": {
          "color": "#b03030",
          "locked": false,
          "secondaryColor": "#2050a0"
        }
      }
    },
    {
      "tool": "set_brush",
      "arguments": {
        "id": "ink-pen"
      },
      "expect": {
        "result": {
          "brush": {
            "dynamics": {
              "minSize": 0.25,
              "pressureSmoothing": 0.4,
              "smoothing": 0.5,
              "velocitySize": -0.45
            },
            "id": "ink-pen",
            "kind": "mark",
            "medium": "ink",
            "name": "Ink pen",
            "tip": {
              "shape": "round",
              "size": 4,
              "spacing": 0.05
            },
            "variety": "pen"
          },
          "engine": "dab",
          "problems": []
        }
      }
    },
    {
      "tool": "get_brush",
      "expect": {
        "result": {
          "brush": {
            "dynamics": {
              "minSize": 0.25,
              "pressureSmoothing": 0.4,
              "smoothing": 0.5,
              "velocitySize": -0.45
            },
            "id": "ink-pen",
            "kind": "mark",
            "medium": "ink",
            "name": "Ink pen",
            "tip": {
              "shape": "round",
              "size": 4,
              "spacing": 0.05
            },
            "variety": "pen"
          },
          "builtin": true,
          "category": "ink",
          "engine": "dab",
          "strokePaint": {
            "color": "#b03030",
            "type": "color"
          }
        }
      }
    },
    {
      "tool": "paint_stroke",
      "arguments": {
        "points": [
          {
            "x": 4,
            "y": 6,
            "pressure": 0.3
          },
          {
            "x": 20,
            "y": 12,
            "pressure": 0.8
          },
          {
            "x": 42,
            "y": 26,
            "pressure": 0.5
          }
        ],
        "seed": 11
      },
      "pixels": true,
      "expect": {
        "result": {
          "bounds": {
            "height": 27,
            "width": 45,
            "x": 1,
            "y": 3
          },
          "dabs": 87,
          "layerId": "@1",
          "strokeId": "s1"
        },
        "pixels": {
          "file": "png/brush-and-colour.5.png",
          "width": 48,
          "height": 32,
          "sha256": "a7d188dfd19eda08d6c3c36bcc369855adb64c22fb72443feaaf99a25f851288",
          "maxDelta": 2,
          "meanDelta": 0.1
        }
      }
    },
    {
      "tool": "pick_color",
      "arguments": {
        "x": 20,
        "y": 12
      },
      "expect": {
        "result": {
          "alpha": 1,
          "color": "#b33939"
        }
      }
    },
    {
      "tool": "set_paint",
      "arguments": {
        "paint": {
          "type": "gradient",
          "stops": [
            {
              "offset": 0,
              "color": "#1d4ed8"
            },
            {
              "offset": 1,
              "color": "#facc15"
            }
          ],
          "map": {
            "by": "distance",
            "length": 40,
            "repeat": "mirror"
          }
        }
      },
      "expect": {
        "result": {
          "color": "#b03030",
          "paint": {
            "map": {
              "by": "distance",
              "length": 40,
              "repeat": "mirror",
              "unit": "px"
            },
            "space": "pigment",
            "stops": [
              {
                "color": "#1d4ed8",
                "offset": 0
              },
              {
                "color": "#facc15",
                "offset": 1
              }
            ],
            "type": "gradient"
          },
          "secondaryColor": "#2050a0"
        }
      }
    },
    {
      "tool": "paint_stroke",
      "arguments": {
        "points": [
          {
            "x": 6,
            "y": 26
          },
          {
            "x": 16,
            "y": 8,
            "pressure": 0.9
          },
          {
            "x": 30,
            "y": 20
          },
          {
            "x": 44,
            "y": 6,
            "pressure": 0.4
          }
        ],
        "seed": 12
      },
      "pixels": true,
      "expect": {
        "result": {
          "bounds": {
            "height": 29,
            "width": 47,
            "x": 1,
            "y": 2
          },
          "dabs": 94,
          "layerId": "@1",
          "mixerLoad": {
            "amount": 1,
            "pickup": null,
            "reservoir": "#a7b735"
          },
          "strokeId": "s2"
        },
        "pixels": {
          "file": "png/brush-and-colour.8.png",
          "width": 48,
          "height": 32,
          "sha256": "b94b9defbe0f600f3dbcc87c4405d9c7d32d2026393f836fa7de13283367f84c",
          "maxDelta": 2,
          "meanDelta": 0.1
        }
      }
    },
    {
      "tool": "set_paint",
      "arguments": {
        "paint": {
          "type": "color",
          "color": "#226633"
        }
      },
      "expect": {
        "result": {
          "color": "#226633",
          "paint": {
            "color": "#226633",
            "type": "color"
          },
          "secondaryColor": "#2050a0"
        }
      }
    },
    {
      "tool": "set_color",
      "arguments": {
        "color": "red"
      },
      "expect": {
        "result": {
          "error": {
            "code": "invalid_arguments",
            "details": [
              {
                "message": "Must match pattern ^#[0-9a-fA-F]{6}$.",
                "path": "/color"
              }
            ],
            "message": "Invalid arguments for tool \"paint-editor__set_color\"."
          }
        },
        "isError": true
      }
    },
    {
      "tool": "get_brush",
      "arguments": {
        "id": "no-such-brush"
      },
      "expect": {
        "result": {
          "error": {
            "code": "tool_failed",
            "message": "Unknown brush \"no-such-brush\". Closest: brush-pen, mixer-brush, impasto-brush. Call list_brush_presets for the ids."
          }
        },
        "isError": true
      }
    }
  ]
}
