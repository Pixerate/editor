      "tool": "run_command",
      "arguments": {
        "id": "vector.addShape",
        "params": {
          "kind": "rect",
          "x": 10,
          "y": 10,
          "width": 60,
          "height": 40,
          "fill": "#0b5fff",
          "stroke": "#e01010",
          "strokeWidth": 2,
          "name": "Logo"
        }
      },
      "expect": {
        "result": {
          "id": "vector.addShape",
          "ok": true,
          "result": {
            "id": "n1"
          }
        }
      }
    },
    {
      "tool": "run_command",
      "arguments": {
        "id": "vector.addShape",
        "params": {
          "kind": "ellipse",
          "x": 90,
          "y": 10,
          "width": 40,
          "height": 40,
          "fill": "#22aa22",
          "stroke": "none"
        }
      },
      "expect": {
        "result": {
          "id": "vector.addShape",
          "ok": true,
          "result": {
            "id": "n2"
          }
