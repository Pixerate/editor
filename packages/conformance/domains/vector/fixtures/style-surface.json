{
  "$schema": "../../../schema/fixture.schema.json",
  "id": "style-surface",
  "description": "The shared house-style checks on the vector surface (#791): palette-only on solid fills and strokes (neutrals allowed), min-contrast for text on the artboard (large and bold text need less), fonts-allowed on text (generic families allowed), and distinguishable, which has no series colours to compare in a drawing; fix_vector_style leaves them all for the agent.",
  "setup": {
    "width": 300,
    "height": 200,
    "background": "#ffffff",
    "style": {
      "palette": [
        "#0b5fff",
        "#ff6a00"
      ],
      "fonts": [
        "Inter"
      ],
      "checks": [
        "palette-only",
        "min-contrast",
        "fonts-allowed",
        "distinguishable"
      ]
    }
  },
