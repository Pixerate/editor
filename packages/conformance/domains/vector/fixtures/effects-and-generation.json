      "tool": "search_effects",
      "arguments": {
        "kind": "vector"
      },
      "expect": {
        "result": {
          "available": true,
          "effects": [
            {
              "category": "sticker",
              "description": "A coloured disc that fades in: a vector effect that brings its own picture.",
              "duration": 500,
              "id": "fake.badge",
              "kind": "vector",
              "loop": false,
              "name": "Badge",
              "tags": [
                "sticker",
                "disc"
              ],
              "transparent": true,
              "uses": [
                "title"
              ]
            },
            {
              "accepts": [
                "path"
              ],
              "category": "path",
              "description": "A vector line along its path control, its picture fitted to the path (viewBox = the path bounds); with no path, a short wave.",
              "duration": 400,
              "id": "fake.route",
              "kind": "vector",
              "loop": false,
              "name": "Route",
              "tags": [
                "path",
                "route"
              ],
              "transparent": true,
              "uses": [
                "title"
              ]
