{
  "$schema": "../../../schema/fixture.schema.json",
  "id": "effects-and-generation",
  "description": "Provider effects on nodes, and generated vector art from the fake generator.",
  "setup": {
    "width": 300,
    "height": 200
  },
  "skip": {
    "swift": "The vector effect and generation tools are not ported yet (#624)."
  },
  "steps": [
    {
      "tool": "run_command",
      "arguments": {
        "id": "vector.addShape",
        "params": {
          "kind": "rect",
          "x": 20,
          "y": 20,
          "width": 100,
          "height": 80,
          "fill": "#2563eb"
        }
      },
      "expect": {
        "result": {
          "id": "vector.addShape",
          "ok": true,
          "result": {
            "id": "n1"
          }
        }
      }
    },
