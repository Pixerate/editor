{
	"prompt": "Make a summary of total sales by region next to the data, starting at G1 (a header row, then one row per region), using formulas so it updates when the data changes.",
	"fixture": {
		"editor": "spreadsheet",
		"rows": [
			[
				"Date",
				"Region",
				"Product",
				"Amount"
			],
			[
				"2026-01-05",
				"North",
				"Widget",
				120
			],
			[
				"2026-01-07",
				"South",
				"Gadget",
				80
			],
			[
				"2026-01-12",
				"North",
				"Gadget",
				95
			],
			[
				"2026-01-15",
				"East",
				"Widget",
				60
			],
			[
				"2026-01-20",
				"West",
				"Widget",
				150
			],
			[
				"2026-02-02",
				"South",
				"Widget",
				110
			],
			[
				"2026-02-08",
				"East",
				"Gadget",
				70
			],
			[
				"2026-02-11",
				"North",
				"Widget",
				130
			],
			[
				"2026-02-19",
				"West",
				"Gadget",
				90
			],
			[
				"2026-02-25",
				"South",
				"Gadget",
				85
			]
		]
	},
	"checks": [
		{
			"why": "one row per region with the right totals",
			"tool": "get_range",
			"args": {
				"range": "G2:H10"
			},
			"expect": {
				"values": {
					"$nonEmpty": {
						"$length": 4,
						"$expr": "[['North',345],['South',275],['East',130],['West',240]].every(([r, t]) => v.some((row) => row[0] === r && row[1] === t))"
					}
				}
			}
		},
		{
			"why": "the totals are formulas over the data, not typed numbers",
			"tool": "get_range",
			"args": {
				"range": "H2:H5"
			},
			"expect": {
				"raw": {
					"$every": {
						"$every": {
							"$match": [
								"^=.*(SUMIFS?|SUMPRODUCT|FILTER)",
								"i"
							]
						}
					}
				}
			}
		},
		{
			"why": "a header row",
			"tool": "get_range",
			"args": {
				"range": "G1:H1"
			},
			"expect": {
				"values": [
					{
						"$every": {
							"$match": "\\S"
						}
					}
				]
			}
		},
		{
			"why": "no formula errors",
			"tool": "get_range",
			"args": {
				"range": "G1:H10"
			},
			"expect": {
				"errors": []
			}
		}
	],
	"solution": [
		{
			"tool": "get_range",
			"args": {
				"range": "A1:D20"
			}
		},
		{
			"tool": "set_range",
			"args": {
				"start": "G1",
				"values": [
					[
						"Region",
						"Total sales"
					],
					[
						"North",
						"=SUMIFS($D$2:$D$11,$B$2:$B$11,G2)"
					],
					[
						"South",
						"=SUMIFS($D$2:$D$11,$B$2:$B$11,G3)"
					],
					[
						"East",
						"=SUMIFS($D$2:$D$11,$B$2:$B$11,G4)"
					],
					[
						"West",
						"=SUMIFS($D$2:$D$11,$B$2:$B$11,G5)"
					]
				]
			}
		},
		{
			"tool": "get_range",
			"args": {
				"range": "G1:H5"
			}
		}
	]
}