{
	"prompt": "Start a drawing of a box: a light pencil sketch first, then clean ink lines over it on a separate layer, and hide the sketch when the inking is done.",
	"fixture": { "editor": "paint", "width": 64, "height": 64, "setup": [{ "tool": "set_paper", "args": { "preset": "smooth" } }] },
	"checks": [
		{ "why": "sketch and ink on separate layers", "tool": "list_strokes", "expect": { "strokes": { "$expr": "v.some((s) => s.brushId.startsWith('pencil')) && v.some((s) => ['ink-pen', 'brush-pen'].includes(s.brushId)) && new Set(v.map((s) => s.layerId)).size >= 2" } } },
		{ "why": "the sketch layer is hidden, the ink layer shown", "tool": "list_layers", "expect": { "layers": { "$some": { "visible": false }, "$length": { "$min": 2 } } } },
		{ "why": "the ink is visible on the page", "tool": "pick_color", "args": { "x": 32, "y": 12 }, "expect": { "color": { "$expr": "(([r, g, b]) => r + g + b < 300)([1, 3, 5].map((i) => parseInt(v.slice(i, i + 2), 16)))" } } }
	],
	"solution": [
		{ "tool": "update_layer", "args": { "layerId": { "$read": "list_layers", "path": "layers.0.id" }, "name": "Sketch" } },
		{ "tool": "set_brush", "args": { "id": "pencil-hb" } },
		{ "tool": "set_color", "args": { "color": "#8a8f98" } },
		{ "tool": "paint_stroke", "args": { "points": [{ "x": 12, "y": 12 }, { "x": 52, "y": 12 }, { "x": 52, "y": 52 }, { "x": 12, "y": 52 }, { "x": 12, "y": 12 }] } },
		{ "tool": "add_layer", "args": { "name": "Ink" } },
		{ "tool": "set_brush", "args": { "id": "ink-pen" } },
		{ "tool": "set_color", "args": { "color": "#111111" } },
		{ "tool": "paint_stroke", "args": { "points": [{ "x": 12, "y": 12 }, { "x": 52, "y": 12 }, { "x": 52, "y": 52 }, { "x": 12, "y": 52 }, { "x": 12, "y": 12 }] } },
		{ "tool": "update_layer", "args": { "layerId": { "$read": "list_layers", "path": "layers.1.id" }, "visible": false } }
	]
}
