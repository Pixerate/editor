{
	"prompt": "A teammate's brush team-impasto is in the library, but it won't work for vector brushstrokes. Make a copy called team-impasto-vector that does, and leave theirs as it is.",
	"fixture": {
		"editor": "brushes",
		"setup": [{ "tool": "create_brush", "args": { "id": "team-impasto", "name": "Team impasto", "basedOn": "impasto-brush", "tags": ["team"] } }]
	},
	"checks": [
		{ "why": "the copy works in the vector editor", "tool": "check_brush", "args": { "id": "team-impasto-vector", "host": "vector" }, "expect": { "ok": true } },
		{ "why": "the copy keeps the impasto brush's tip", "tool": "describe_brush", "args": { "id": "team-impasto-vector" }, "expect": { "brush": { "tip": { "size": 36, "roundness": 0.55 } } } },
		{ "why": "the teammate's brush still lays thick paint", "tool": "describe_brush", "args": { "id": "team-impasto" }, "expect": { "brush": { "behaviour": { "surface": "thick" } } } }
	],
	"solution": [
		{ "tool": "check_brush", "args": { "id": "team-impasto", "host": "vector" } },
		{ "tool": "create_brush", "args": { "id": "team-impasto-vector", "name": "Team impasto (vector)", "basedOn": "team-impasto", "behaviour": { "surface": "wet" } } },
		{ "tool": "check_brush", "args": { "id": "team-impasto-vector", "host": "vector" } }
	]
}
