{
	"prompt": "Space the three cards evenly across, keeping the first and last where they are.",
	"fixture": {
		"editor": "canvas",
		"nodes": [
			{
				"id": "a",
				"type": "shape",
				"position": {
					"x": 0,
					"y": 0
				},
				"width": 100,
				"height": 80,
				"data": {
					"label": "Card A",
					"shape": {
						"kind": "rect",
						"fill": "#eeeeee"
					}
				}
			},
			{
				"id": "b",
				"type": "shape",
				"position": {
					"x": 120,
					"y": 0
				},
				"width": 100,
				"height": 80,
				"data": {
					"label": "Card B",
					"shape": {
						"kind": "rect",
						"fill": "#eeeeee"
					}
				}
			},
			{
				"id": "c",
				"type": "shape",
				"position": {
					"x": 300,
					"y": 0
				},
				"width": 100,
				"height": 80,
				"data": {
					"label": "Card C",
					"shape": {
						"kind": "rect",
						"fill": "#eeeeee"
					}
				}
			}
		]
	},
	"checks": [
		{
			"why": "equal gaps between the cards",
			"tool": "get_canvas_document",
			"expect": {
				"document": {
					"nodes": {
						"$expr": "(() => { const xs = v.map((n) => n.position.x).sort((p, q) => p - q); return Math.abs((xs[1] - xs[0]) - (xs[2] - xs[1])) <= 1; })()"
					}
				}
			}
		},
		{
			"why": "the outer cards stay put",
			"tool": "get_canvas_document",
			"expect": {
				"document": {
					"nodes": {
						"$expr": "v.find((n) => n.id === 'a').position.x === 0 && v.find((n) => n.id === 'c').position.x === 300"
					}
				}
			}
		}
	],
	"solution": [
		{
			"tool": "run_command",
			"args": {
				"id": "canvas.distributeHorizontal",
				"params": {
					"ids": [
						"a",
						"b",
						"c"
					]
				}
			}
		}
	]
}