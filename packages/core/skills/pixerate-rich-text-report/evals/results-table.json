{
	"prompt": "Under 'Sales by region:', add a table with a header row (Region, Sales) and two rows: North 120 and South 95.",
	"fixture": {
		"editor": "rich-text",
		"html": "<h2>Results</h2><p>Sales by region:</p><h2>Next steps</h2>"
	},
	"checks": [
		{
			"why": "a table with a header row and the two regions",
			"tool": "get_text",
			"args": {
				"format": "html"
			},
			"expect": {
				"content": {
					"$match": "<table[^>]*>.*<th[^>]*><p>Region</p></th><th[^>]*><p>Sales</p></th>.*<td[^>]*><p>North</p></td><td[^>]*><p>120</p></td>.*<td[^>]*><p>South</p></td><td[^>]*><p>95</p></td>.*</table>"
				}
			}
		},
		{
			"why": "placed after 'Sales by region:' and before the next section",
			"tool": "get_text",
			"args": {
				"format": "html"
			},
			"expect": {
				"content": {
					"$match": "Sales by region:</p><table.*</table><h2[^>]*>Next steps"
				}
			}
		}
	],
	"solution": [
		{
			"tool": "get_text",
			"args": {
				"blocks": true
			}
		},
		{
			"tool": "edit_table",
