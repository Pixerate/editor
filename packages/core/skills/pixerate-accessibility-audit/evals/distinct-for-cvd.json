{
	"prompt": "These three status dots (OK, warning, error) must be told apart by colour-blind users too. Fix their colours.",
	"fixture": {
		"editor": "vector",
		"width": 120,
		"height": 40,
		"colorTools": true,
		"setup": [
			{
				"id": "vector.addShape",
				"params": {
					"kind": "ellipse",
					"x": 10,
					"y": 10,
					"width": 20,
					"height": 20,
					"name": "OK",
					"fill": "#2ca02c",
					"stroke": null
				}
			},
			{
				"id": "vector.addShape",
				"params": {
					"kind": "ellipse",
					"x": 50,
					"y": 10,
					"width": 20,
					"height": 20,
					"name": "Warning",
					"fill": "#bcbd22",
					"stroke": null
				}
			},
			{
				"id": "vector.addShape",
				"params": {
					"kind": "ellipse",
					"x": 90,
					"y": 10,
					"width": 20,
					"height": 20,
					"name": "Error",
					"fill": "#d62728",
					"stroke": null
				}
			}
		]
	},
	"checks": [
		{
			"why": "the three colours pass the colour-vision check",
			"tool": "check_color_palette",
			"args": {
				"colors": {
					"$read": "run_command",
					"args": {
						"id": "vector.list"
					},
					"path": "result.nodes.*.fill"
				}
			},
			"expect": {
				"ok": true
			}
		},
		{
			"why": "still three dots",
			"tool": "run_command",
			"args": {
				"id": "vector.list"
			},
			"expect": {
				"result": {
					"nodes": {
						"$length": 3
					}
				}
			}
		}
	],
	"solution": [
		{
			"tool": "check_color_palette",
			"args": {
				"colors": [
					"#2ca02c",
					"#bcbd22",
					"#d62728"
				]
			}
		},
		{
			"tool": "run_command",
			"args": {
				"id": "vector.setStyle",
				"params": {
					"ids": [
						{
							"$read": "run_command",
							"args": {
								"id": "vector.list"
							},
							"path": "result.nodes.0.id"
						}
					],
					"fill": "#0072b2"
				}
			}
		},
		{
			"tool": "run_command",
			"args": {
				"id": "vector.setStyle",
				"params": {
					"ids": [
						{
							"$read": "run_command",
							"args": {
								"id": "vector.list"
							},
							"path": "result.nodes.1.id"
						}
					],
					"fill": "#e69f00"
				}
			}
		},
		{
			"tool": "run_command",
			"args": {
				"id": "vector.setStyle",
				"params": {
					"ids": [
						{
							"$read": "run_command",
							"args": {
								"id": "vector.list"
							},
							"path": "result.nodes.2.id"
						}
					],
					"fill": "#000000"
				}
			}
		},
		{
			"tool": "check_color_palette",
			"args": {
				"colors": {
					"$read": "run_command",
					"args": {
						"id": "vector.list"
					},
					"path": "result.nodes.*.fill"
				}
			}
		}
	]
}