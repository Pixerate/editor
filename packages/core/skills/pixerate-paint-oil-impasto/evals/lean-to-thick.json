{
	"prompt": "Paint this the traditional way: block in the background first with thin paint, then build the subject in the centre with thick paint on top.",
	"fixture": { "editor": "paint", "width": 64, "height": 64, "setup": [{ "tool": "set_paper", "args": { "preset": "cotton-canvas" } }] },
	"checks": [
		{ "why": "thin paint first", "tool": "list_strokes", "expect": { "strokes": { "$expr": "v.length >= 2 && ['oil-round', 'oil-flat', 'bristle-flat', 'bristle-round', 'dry-brush'].includes(v[0].brushId)" } } },
		{ "why": "thick paint after it", "tool": "list_strokes", "expect": { "strokes": { "$expr": "v.slice(1).some((s) => ['impasto-brush', 'palette-knife', 'paint-tube', 'gloop-pen'].includes(s.brushId))" } } },
		{ "why": "the thick paint stands up from the canvas", "tool": "get_relief", "expect": { "relief": { "maxHeight": { "$min": 50 } } } }
	],
	"solution": [
		{ "tool": "set_brush", "args": { "id": "oil-flat" } },
		{ "tool": "set_color", "args": { "color": "#6b7f6a" } },
		{ "tool": "paint_stroke", "args": { "points": [{ "x": 0, "y": 8 }, { "x": 64, "y": 8 }, { "x": 64, "y": 24 }, { "x": 0, "y": 24 }, { "x": 0, "y": 40 }, { "x": 64, "y": 40 }, { "x": 64, "y": 56 }, { "x": 0, "y": 56 }] } },
		{ "tool": "set_brush", "args": { "id": "impasto-brush" } },
		{ "tool": "set_color", "args": { "color": "#d9783b" } },
		{ "tool": "paint_stroke", "args": { "points": [{ "x": 24, "y": 32 }, { "x": 40, "y": 32 }] } }
	]
}
