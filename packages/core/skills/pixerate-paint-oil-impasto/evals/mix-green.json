{
	"prompt": "Mix a green from ultramarine (#1f3a93) and cadmium yellow (#f2c500) the way real paint mixes, then paint a short oil stroke with it from (10, 32) to (54, 32).",
	"fixture": { "editor": "paint", "width": 64, "height": 64, "setup": [{ "tool": "set_paper", "args": { "preset": "cotton-canvas" } }] },
	"checks": [
		{ "why": "the stroke's colour is a green", "tool": "list_strokes", "expect": { "strokes": { "$some": { "color": { "$expr": "(([r, g, b]) => g > r && g > b)([1, 3, 5].map((i) => parseInt(v.slice(i, i + 2), 16)))" } } } } },
		{ "why": "the canvas shows green paint", "tool": "pick_color", "args": { "x": 32, "y": 32 }, "expect": { "color": { "$expr": "(([r, g, b]) => g > r && g > b)([1, 3, 5].map((i) => parseInt(v.slice(i, i + 2), 16)))" } } },
		{ "why": "an oil brush", "tool": "list_strokes", "expect": { "strokes": { "$some": { "brushId": { "$in": ["oil-round", "oil-flat", "bristle-round", "bristle-flat", "impasto-brush", "palette-knife"] } } } } }
	],
	"solution": [
		{ "tool": "mix_colors", "args": { "colors": [{ "color": "#1f3a93", "weight": 1 }, { "color": "#f2c500", "weight": 1 }] } },
		{ "tool": "set_brush", "args": { "id": "oil-round" } },
		{ "tool": "set_color", "args": { "color": { "$read": "mix_colors", "args": { "colors": [{ "color": "#1f3a93", "weight": 1 }, { "color": "#f2c500", "weight": 1 }] }, "path": "mixed" } } },
		{ "tool": "paint_stroke", "args": { "points": [{ "x": 10, "y": 32 }, { "x": 54, "y": 32 }] } }
	]
}
