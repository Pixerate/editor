{
  "name": "@pixerate/editor",
  "version": "0.11.0",
  "description": "UI-agnostic rich text and media editing core library",
  "author": "Pixerate",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Pixerate/editor.git",
    "directory": "packages/core"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./grammar": {
      "types": "./dist/grammar/index.d.ts",
      "import": "./dist/grammar/index.js",
      "require": "./dist/grammar/index.cjs"
    },
    "./extensions": {
      "types": "./dist/extensions/index.d.ts",
      "import": "./dist/extensions/index.js",
      "require": "./dist/extensions/index.cjs"
    },
    "./serializers": {
      "types": "./dist/serializers/index.d.ts",
      "import": "./dist/serializers/index.js",
      "require": "./dist/serializers/index.cjs"
    },
    "./spreadsheet": {
      "types": "./dist/spreadsheet/index.d.ts",
      "import": "./dist/spreadsheet/index.js",
      "require": "./dist/spreadsheet/index.cjs"
    },
    "./history": {
      "types": "./dist/history/index.d.ts",
      "import": "./dist/history/index.js",
      "require": "./dist/history/index.cjs"
    },
    "./canvas": {
      "types": "./dist/canvas/index.d.ts",
      "import": "./dist/canvas/index.js",
      "require": "./dist/canvas/index.cjs"
    },
    "./agent": {
      "types": "./dist/agent/index.d.ts",
      "import": "./dist/agent/index.js",
      "require": "./dist/agent/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-character-count": "^3.31.4",
    "@tiptap/extension-color": "^3.31.4",
    "@tiptap/extension-highlight": "^3.31.4",
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/extension-link": "^3.31.4",
    "@tiptap/extension-mention": "^3.31.4",
    "@tiptap/extension-placeholder": "^3.31.4",
    "@tiptap/extension-subscript": "^3.31.4",
    "@tiptap/extension-superscript": "^3.31.4",
    "@tiptap/extension-task-item": "^3.31.4",
    "@tiptap/extension-task-list": "^3.31.4",
    "@tiptap/extension-text-align": "^3.31.4",
    "@tiptap/extension-text-style": "^3.31.4",
    "@tiptap/extension-typography": "^3.31.4",
    "@tiptap/extension-underline": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@tiptap/suggestion": "^3.31.4",
    "markdown-it": "^15.0.2",
    "markdown-it-task-lists": "^2.1.1",
    "prosemirror-markdown": "^1.13.8",
    "tiptap-markdown": "^0.9.0"
  },
  "devDependencies": {
    "@types/dagre": "^0.7.54",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.3",
    "tsup": "^8.4.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
