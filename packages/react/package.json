{
  "name": "@pixerate/editor-react",
  "version": "0.3.2",
  "description": "React bindings and prompt/rich-text components for @pixerate/editor",
  "author": "Pixerate",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Pixerate/editor.git",
    "directory": "packages/react"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@pixerate/editor": "workspace:*",
    "@tiptap/core": "^2.11.5 || ^3.0.0",
    "@tiptap/extension-bubble-menu": "^2.11.5 || ^3.0.0",
    "@tiptap/extension-placeholder": "^2.11.5 || ^3.0.0",
    "@tiptap/pm": "^2.11.5 || ^3.0.0",
    "@tiptap/react": "^2.11.5 || ^3.0.0",
    "@tiptap/starter-kit": "^2.11.5 || ^3.0.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
